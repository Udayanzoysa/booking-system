DATABASE_URL=postgresql://booking:replace-with-database-password@localhost:5432/booking
JWT_SECRET=
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

# Google Identity Services web client ID. Empty disables customer Google sign-in.
# Register each frontend origin in Google Cloud; no client secret is needed.
GOOGLE_CLIENT_ID=

# Private per-booking attachment storage; mount this directory in production.
ATTACHMENTS_DIR=./uploads
# Base64-encoded random 32-byte AES key. Required for saving PayHere secrets in the admin UI.
# Keep this key stable and back it up separately from the database.
PAYMENT_SETTINGS_ENCRYPTION_KEY=

# PayHere sandbox only. Secrets remain on the backend; no live gateway is used.
# Enable for the matching tenant only. notify_url must be publicly reachable HTTPS.
# Add the site's domain in your PayHere sandbox merchant account first.
PAYHERE_SANDBOX_ENABLED=0
PAYHERE_TENANT_SLUG=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
PAYMENT_RETURN_ORIGIN=http://localhost:3001

# Bank transfer account details are configured per arena in the staff dashboard.

# One-time tenant setup. Provide the password through the environment at runtime.
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_CURRENCY=
BOOTSTRAP_UNPAID_HOLD_MINUTES=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_STAFF_EMAIL=staff@strikzclub.test
BOOTSTRAP_STAFF_NAME=Strikz Staff
# db:strikz-setup needs BOOTSTRAP_ADMIN_PASSWORD and BOOTSTRAP_STAFF_PASSWORD in the shell.
# Optional initial pricing/schedule; leave the price empty to configure it in the dashboard.
BOOTSTRAP_PRICE_PER_HOUR=
BOOTSTRAP_SCHEDULE_DAYS=14
