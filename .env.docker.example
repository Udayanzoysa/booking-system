POSTGRES_USER=booking
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=booking

# Must be at least 32 UTF-8 bytes
JWT_SECRET=replace-with-at-least-32-character-random-secret

# Public origin used by users in their browser (no trailing slash)
FRONTEND_ORIGIN=https://strikzclub.techwing.cloud
# Leave empty for same-origin reverse proxy via Nginx (/api and /socket.io)
NEXT_PUBLIC_BOOKING_API_ORIGIN=
NEXT_PUBLIC_CUSTOMER_TENANT_SLUG=techwing-arena
NEXT_PUBLIC_CUSTOMER_BRANCH_ID=

# Bind ports on localhost when fronted by Nginx on the host
API_BIND_IP=127.0.0.1
API_PORT=3100
WEB_BIND_IP=127.0.0.1
WEB_PORT=3101

# One-time initial tenant bootstrap (run with: docker compose exec -e BOOTSTRAP_ADMIN_PASSWORD=... api npm run db:bootstrap)
BOOTSTRAP_TENANT_SLUG=techwing-arena
BOOTSTRAP_TENANT_NAME=Techwing Arena
BOOTSTRAP_CURRENCY=LKR
BOOTSTRAP_UNPAID_HOLD_MINUTES=15
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Arena Admin
