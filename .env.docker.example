POSTGRES_USER=booking
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=booking

# Must be at least 32 UTF-8 bytes
JWT_SECRET=replace-with-at-least-32-character-random-secret

# Public origin used by users in their browser (no trailing slash)
FRONTEND_ORIGIN=https://strikzclub.techwing.cloud
# Google OAuth 2.0 Web client ID; configure the public origin in Google Cloud.
GOOGLE_CLIENT_ID=
# Leave empty for same-origin reverse proxy via Nginx (/api and /socket.io)
NEXT_PUBLIC_BOOKING_API_ORIGIN=
NEXT_PUBLIC_CUSTOMER_TENANT_SLUG=strikzclub-homagama
NEXT_PUBLIC_CUSTOMER_BRANCH_ID=

# Sandbox only. Bank account details are managed in Dashboard > Payment settings.
PAYHERE_SANDBOX_ENABLED=0
PAYHERE_TENANT_SLUG=strikzclub-homagama
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=https://strikzclub.techwing.cloud/api/payments/payhere/notify
PAYMENT_RETURN_ORIGIN=https://strikzclub.techwing.cloud
# Generate 32 random bytes encoded as base64; retain the key for credential decryption.
PAYMENT_SETTINGS_ENCRYPTION_KEY=

# Bind ports on localhost when fronted by Nginx on the host
API_BIND_IP=127.0.0.1
API_PORT=3100
WEB_BIND_IP=127.0.0.1
WEB_PORT=3101

# One-time Strikz setup: pass BOOTSTRAP_ADMIN_PASSWORD and BOOTSTRAP_STAFF_PASSWORD
# at runtime to: docker compose exec api npm run db:strikz-setup
BOOTSTRAP_TENANT_SLUG=strikzclub-homagama
BOOTSTRAP_TENANT_NAME=Strikz Club - Homagama
BOOTSTRAP_CURRENCY=LKR
BOOTSTRAP_UNPAID_HOLD_MINUTES=15
BOOTSTRAP_ADMIN_EMAIL=admin@strikzclub.test
BOOTSTRAP_ADMIN_NAME=Strikz Administrator
BOOTSTRAP_STAFF_EMAIL=staff@strikzclub.test
BOOTSTRAP_STAFF_NAME=Strikz Staff
# Optional: create initial hourly slots from 07:00 to 22:00 with this rate.
BOOTSTRAP_PRICE_PER_HOUR=
BOOTSTRAP_SCHEDULE_DAYS=14
